# Sao chép thành .env rồi đặt mật khẩu thật:  cp .env.example .env
# File .env không được commit.

# PostgreSQL (dịch vụ db trong compose.yaml)
POSTGRES_DB=dapchuot
POSTGRES_USER=dapchuot
POSTGRES_PASSWORD=doi-mat-khau-database-nay

# Tài khoản trang /admin. Mật khẩu tối thiểu 12 ký tự; để trống thì trang admin bị tắt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 1 khi chạy sau HTTPS (thêm cờ Secure cho cookie phiên)
COOKIE_SECURE=0
# 1 khi có reverse proxy phía trước (lấy IP từ X-Forwarded-For)
TRUST_PROXY=0
